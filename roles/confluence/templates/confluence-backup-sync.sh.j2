#!/usr/bin/env bash
set -euo pipefail

LOCK_DIR="/run/confluence-backup-sync.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "Confluence backup sync is already running"
  exit 0
fi
trap 'rmdir "$LOCK_DIR"' EXIT

POSTGRES_VOLUME="{{ confluence_compose_project_name }}_confluence-database-backups"
DATA_VOLUME="{{ confluence_compose_project_name }}_confluence-data-backups"
POSTGRES_SOURCE="$(docker volume inspect "$POSTGRES_VOLUME" --format '{% raw %}{{ .Mountpoint }}{% endraw %}')"
DATA_SOURCE="$(docker volume inspect "$DATA_VOLUME" --format '{% raw %}{{ .Mountpoint }}{% endraw %}')"

REMOTE="{{ confluence_remote_backup_user }}@{{ confluence_remote_backup_host }}"
REMOTE_PATH="{{ confluence_remote_backup_path }}"
SSH_PORT="{{ confluence_remote_backup_port }}"
SSH_KEY="{{ confluence_remote_backup_identity_file }}"
STRICT_HOST_KEY_CHECKING="{% if confluence_remote_backup_strict_host_key_checking | bool %}yes{% else %}no{% endif %}"

SSH_OPTS=(
  -p "$SSH_PORT"
  -i "$SSH_KEY"
  -o BatchMode=yes
  -o StrictHostKeyChecking="$STRICT_HOST_KEY_CHECKING"
)

ssh "${SSH_OPTS[@]}" "$REMOTE" "mkdir -p '$REMOTE_PATH/postgres' '$REMOTE_PATH/data'"
rsync -az --delete -e "ssh ${SSH_OPTS[*]}" "$POSTGRES_SOURCE/" "$REMOTE:$REMOTE_PATH/postgres/"
rsync -az --delete -e "ssh ${SSH_OPTS[*]}" "$DATA_SOURCE/" "$REMOTE:$REMOTE_PATH/data/"
